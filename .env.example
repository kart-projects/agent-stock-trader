# ===========================================
# AI Stock Trader - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Database (Required)
# ===========================================
# PostgreSQL connection string
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For local: postgresql://user:password@localhost:5432/agent_stock_trader
DATABASE_URL="postgresql://user:password@localhost:5432/agent_stock_trader?schema=public"

# ===========================================
# AI Model API Keys
# ===========================================
# Free Tier (at least one required for analysis)
GOOGLE_AI_API_KEY=""        # Get from: https://ai.google.dev
GROQ_API_KEY=""             # Get from: https://console.groq.com

# Paid Tier (optional - enable in config/models.ts when ready)
ANTHROPIC_API_KEY=""        # Get from: https://console.anthropic.com
OPENAI_API_KEY=""           # Get from: https://platform.openai.com

# ===========================================
# Authentication (Required)
# ===========================================
# NextAuth.js secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ===========================================
# AWS Services (Required for production)
# ===========================================
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"

# SES Email Configuration
AWS_SES_FROM_EMAIL="alerts@yourdomain.com"

# ===========================================
# Stock Data APIs (Optional)
# ===========================================
# Yahoo Finance doesn't require an API key

# Alpha Vantage (25 free requests/day)
ALPHA_VANTAGE_API_KEY=""    # Get from: https://www.alphavantage.co/support/

# Polygon.io (optional, for more data)
POLYGON_API_KEY=""          # Get from: https://polygon.io

# ===========================================
# Application Settings
# ===========================================
NODE_ENV="development"

# Feature flags
ENABLE_SCHEDULED_ANALYSIS="true"
ENABLE_EMAIL_ALERTS="true"

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE="60"
