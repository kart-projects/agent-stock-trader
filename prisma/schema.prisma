// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==================== User Management ====================

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String?
  password    String?           // For credential auth (hashed)
  image       String?
  watchlist   Stock[]           @relation("UserWatchlist")
  alerts      Alert[]
  preferences UserPreferences?
  accounts    Account[]
  sessions    Session[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  id                 String  @id @default(cuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailAlerts        Boolean @default(true)
  minConsensusModels Int     @default(3) // How many models must agree
  minConfidenceScore Float   @default(70) // Minimum avg confidence (0-100)
  alertFrequency     String  @default("IMMEDIATE") // IMMEDIATE, DAILY_DIGEST

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== Stock Data ====================

model Stock {
  id       String     @id @default(cuid())
  symbol   String     @unique
  name     String
  sector   String?
  industry String?
  users    User[]     @relation("UserWatchlist")
  analyses Analysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== Analysis & AI Models ====================

model Analysis {
  id      String @id @default(cuid())
  stockId String
  stock   Stock  @relation(fields: [stockId], references: [id], onDelete: Cascade)

  // Store individual model responses as JSON for flexibility
  // This allows dynamic model configuration without schema changes
  modelResponses Json // Array of { modelId, modelName, rating, confidence, reasoning }

  // Consensus results
  consensus     String? // BUY, SELL, HOLD, or null if no consensus
  avgConfidence Float?
  hasConsensus  Boolean @default(false)
  modelsUsed    Int     @default(0)

  // Market data at time of analysis
  priceAtAnalysis Float
  volumeAtAnalysis BigInt?
  marketCapAtAnalysis BigInt?

  // Metadata
  analysisType String   @default("SCHEDULED") // SCHEDULED, ON_DEMAND
  createdAt    DateTime @default(now())

  @@index([stockId, createdAt])
  @@index([consensus, createdAt])
}

// ==================== Alerts ====================

model Alert {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stockSymbol String
  alertType   String // CONSENSUS_BUY, CONSENSUS_SELL, CONSENSUS_HOLD
  message     String  @db.Text
  emailSent   Boolean @default(false)
  emailSentAt DateTime?

  // Reference to the analysis that triggered this alert
  analysisId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([stockSymbol, alertType])
}

// ==================== Model Configuration (Runtime) ====================

model ModelConfiguration {
  id                    String  @id @default(cuid())
  modelId               String  @unique // e.g., 'gemini-flash', 'groq-llama'
  name                  String
  provider              String // anthropic, openai, google, groq
  model                 String // actual model identifier
  enabled               Boolean @default(true)
  costPerMillionInput   Float   @default(0)
  costPerMillionOutput  Float   @default(0)
  maxTokens             Int     @default(1024)
  rateLimitPerMinute    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== Analysis Job Queue ====================

model AnalysisJob {
  id          String   @id @default(cuid())
  stockSymbol String
  status      String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  priority    Int      @default(0)
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  error       String?  @db.Text
  result      Json?

  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, scheduledFor])
  @@index([stockSymbol, status])
}
